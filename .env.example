# XGOLDA LOCALHOST ENVIRONMENT
# Salin ke .env.local lalu isi nilai aslinya. JANGAN commit .env.local.

PORT=3000

# Inference gateway (OpenAI-compatible). 9Router di localhost PC user.
INTERNAL_INFERENCE_ENDPOINT=http://localhost:20128/v1
AI_GATEWAY_TOKEN=isi-token-9router-di-sini
DEFAULT_MODEL=deepseek-ai/DeepSeek-R1

# Opsional: endpoint embedding terpisah (untuk vector search).
# Jika kosong, pakai INTERNAL_INFERENCE_ENDPOINT.
EMBEDDING_ENDPOINT=
EMBEDDING_MODEL=text-embedding-3-small

SQLITE_DB_PATH=./data/xgolda.db
EXECUTION_TIMEOUT_MS=15000
APPROVAL_TIMEOUT_MS=300000
AGENT_MAX_STEPS=12

# Retry gateway (429/5xx/network): jumlah percobaan & backoff dasar
AI_RETRY_ATTEMPTS=3
AI_RETRY_BASE_MS=1000
